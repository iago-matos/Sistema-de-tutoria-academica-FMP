# Modelo de configuracao local.
# Copie este arquivo para ".env" (nesta mesma pasta) e preencha os valores.
# O ".env" nunca vai para o GitHub: ele esta no .gitignore.
# Nao use barra invertida (\) nos valores.

# Banco de dados (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/tutoria_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Segredo que assina os tokens JWT. Minimo de 32 caracteres.
# Gere um no Git Bash com:  openssl rand -base64 48
JWT_SECRET=

# Administradores criados automaticamente ao subir a aplicacao.
# E-mails separados por virgula. Se o e-mail ja existir, a conta e promovida
# a administrador sem trocar a senha. Senha inicial: minimo de 8 caracteres.
ADMIN_EMAILS=admin1@exemplo.com,admin2@exemplo.com,admin3@exemplo.com
ADMIN_SENHA_INICIAL=

# Origens que podem chamar a API, separadas por virgula
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Exibe no console o SQL gerado pelo Hibernate (true/false)
JPA_SHOW_SQL=false
