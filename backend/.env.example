# Modelo de configuracao local.
# Copie este arquivo para ".env" (nesta mesma pasta) e preencha os valores.
# O ".env" nunca vai para o GitHub: ele esta no .gitignore.
# Nao use barra invertida (\) nos valores.

# Banco de dados (SQL Server / Azure SQL Database)
#
# Azure SQL (troque o nome do servidor):
# DB_URL=jdbc:sqlserver://sql-tutoria-fmp.database.windows.net:1433;databaseName=tutoria_db;encrypt=true;trustServerCertificate=false;hostNameInCertificate=*.database.windows.net;loginTimeout=30
#
# SQL Server local (Express, Developer ou Docker):
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=tutoria_db;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=

# Segredo que assina os tokens JWT. Minimo de 32 caracteres.
# Gere um no Git Bash com:  openssl rand -base64 48
JWT_SECRET=

# Administradores criados automaticamente ao subir a aplicacao.
# E-mails separados por virgula. Se o e-mail ja existir, a conta e promovida
# a administrador sem trocar a senha. Senha inicial: minimo de 8 caracteres.
ADMIN_EMAILS=admin1@exemplo.com,admin2@exemplo.com,admin3@exemplo.com
ADMIN_SENHA_INICIAL=

# Login com Google (so contas do dominio institucional). Crie o "ID do cliente
# OAuth" (tipo: Aplicativo da Web) no Google Cloud Console: veja o README.
# Sem GOOGLE_CLIENT_ID o botao do Google nao aparece. O client ID nao e segredo.
GOOGLE_CLIENT_ID=
# Dominios aceitos, separados por virgula (professores e alunos)
GOOGLE_DOMINIOS=fmpsc.edu.br,aluno.fmpsc.edu.br

# Disciplinas criadas no primeiro uso (separadas por virgula). Depois, a lista
# e mantida pela coordenacao na guia "Disciplinas". Vazio: usa o padrao abaixo.
# DISCIPLINAS_INICIAIS=Matemática,Lógica de Programação,Banco de Dados,Algoritmos

# Cadastro publico com e-mail e senha. false: contas novas so pelo Google.
# Ligue (true) so em desenvolvimento, por exemplo para criar contas de teste.
CADASTRO_COM_SENHA=false

# Dados de demonstracao: cria estudante.demo@exemplo.com com tutorias ja feitas
# (e 4 tutores demo), para testar a tela de avaliacao. So em desenvolvimento.
# Todos entram com a senha DEMO_SENHA (minimo de 8 caracteres).
DEMO_DADOS=false
DEMO_SENHA=
# Opcional: e-mail da sua conta de estudante (ja cadastrada). Ela ganha as
# mesmas tutorias de teste, para ver os perfis logado como voce.
DEMO_ESTUDANTE_EMAIL=

# Origens que podem chamar a API, separadas por virgula.
# Para usar o frontend publicado no GitHub Pages, inclua a origem dele
# (so o dominio, sem o caminho do repositorio):
# CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://iago-matos.github.io
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Exibe no console o SQL gerado pelo Hibernate (true/false)
JPA_SHOW_SQL=false
